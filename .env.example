# Local secrets shared by the API and the agents service. Copy to .env (gitignored) and fill in.
# Both services read this file, so start them from any terminal.

# Shared token the C# API sends in X-Service-Token and the agents service checks. Any long random string, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
AGENT_SERVICE_TOKEN=

# Optional: Google sign-in for the API (see README › Google sign-in). "__" becomes ":" in .NET configuration.
# Authentication__Google__ClientId=
# Authentication__Google__ClientSecret=
